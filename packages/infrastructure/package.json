{
  "name": "@paopao/infrastructure",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/ai/*.test.ts test/backup/*.test.ts test/database/*.test.ts",
    "build": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@paopao/contracts": "0.1.0",
    "@paopao/core": "0.1.0",
    "better-sqlite3": "12.6.2"
  },
  "devDependencies": {
    "tsx": "4.19.2"
  }
}
